# Copier en .env et renseigner les valeurs (ne jamais committer .env)
CLAUDE_API_KEY=
# WORKSPACE_ID=        # si la clé n'est pas rattachée à un espace de travail
PORT=3000
MODEL=claude-sonnet-5-5
# EFFORT=low
# MAX_OUTPUT_TOKENS=1500
# RATE_LIMIT_PER_MIN=8
# DAILY_BUDGET_USD=5
# CORS_ORIGINS=        # liste séparée par des virgules
# TRUST_PROXY=
# FALLBACKS=off

# --- Fournisseur de modèle (défaut : anthropic) ---
# PROVIDER=anthropic              # ou openai-compatible (OVHcloud AI Endpoints, vLLM, Ollama…)
# LLM_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# LLM_API_KEY=                    # ou OVH_AI_ENDPOINTS_ACCESS_TOKEN=
# LLM_TEMPERATURE=0.2
# LLM_REASONING_EFFORT=low        # facultatif (gpt-oss…)
# LLM_THINK_PREFIXED=1            # modèle qui n'émet que </think>
# PRICE_INPUT_PER_M=2             # USD / million de tokens (plafond de dépense) ; défaut Sonnet 5.5 : 2 / 10
# PRICE_OUTPUT_PER_M=10
# EXPOSE_USAGE=1                  # serveur de test seulement (test/compare.mjs)
# MAX_FICHE_CHARS=40000           # plafond de taille d'une fiche renvoyée au modèle (le règlement intérieur n'est jamais tronqué)

# --- Profil « anonyme » (facultatif) : visiteurs non connectés (aucune donnée personnelle, 5 questions) ---
# Les variables sans préfixe ci-dessus forment le profil « membre » (personnes connectées). Absent = même modèle pour tous.
# Un profil anonyme existe dès que ANON_MODEL (ou ANON_PROVIDER) est défini. Hérités du profil membre : fournisseur, URL de base,
# clé (OVH par défaut), température, limite de sortie, tarifs. NON hérités : effort de raisonnement, libellé, hébergement.
# ANON_PROVIDER=openai-compatible
# ANON_MODEL=
# ANON_LLM_BASE_URL=
# ANON_LLM_API_KEY=                # défaut : clé du profil membre / OVH
# ANON_LLM_REASONING_EFFORT=low
# ANON_MAX_OUTPUT_TOKENS=2500
# ANON_PRICE_INPUT_PER_M=          # USD / million de tokens (plafond de dépense DAILY_BUDGET_USD commun aux deux profils)
# ANON_PRICE_OUTPUT_PER_M=
# ANON_MODEL_LABEL=                # pied de page des visiteurs anonymes
# ANON_MODEL_HOSTING=              # mention d'hébergement, à renseigner seulement si exacte

# --- Limite des visiteurs anonymes ---
# ANON_MAX_QUESTIONS=5
# ANON_MAX_QUESTIONS_PER_IP_PER_DAY=15   # contre le contournement par suppression du cookie (mettre 1000 pour npm run eval)
# PDF_RATE_LIMIT_PER_MIN=30

# --- Connexion SSO (OAuth2 Authorization Code + PKCE S256, client public sans secret) ---
# Laisser vide pour désactiver la connexion (mode anonyme seulement).
SSO_ISSUER=
SSO_CLIENT_ID=
PUBLIC_URL=http://localhost:3000
# SSO_SCOPE=basic
# SSO_AUTHORIZE_URL= / SSO_TOKEN_URL= / SSO_USERINFO_URL= / SSO_REVOKE_URL=   # par défaut : <SSO_ISSUER>/oauth/{authorize,token,me,revoke}/
# SSO_OIDC=0           # 1 : exiger et valider un id_token (JWKS, iss, aud, exp, nonce)
# MEMBER_API_URL=      # endpoint de synthèse du membre (défaut : <SSO_ISSUER>/api-json-wp/cowo/v1/me/summary ; « off » pour désactiver)
# SESSION_TTL_DAYS=7
# Affichés en bas de page : nom lisible du modèle (sinon MODEL) et mention d'hébergement (à renseigner seulement si exacte)
# MODEL_LABEL=
# MODEL_HOSTING=hébergé en France chez OVHcloud
